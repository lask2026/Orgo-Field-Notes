{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orgo-field-notes.local/schema/chapter.schema.json",
  "title": "Orgo Field Notes chapter",
  "description": "Original chapter content. Molecular and atom cross-references are additionally validated by the integration tests.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 2
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "label",
          "location"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "draft",
            "author-reviewed",
            "expert-reviewed"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "note"
      ],
      "additionalProperties": false
    },
    "lessons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lesson"
      },
      "minItems": 1
    },
    "exercises": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exercise"
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "description",
    "objectives",
    "sources",
    "review",
    "lessons",
    "exercises"
  ],
  "additionalProperties": false,
  "$defs": {
    "highlights": {
      "type": "object",
      "properties": {
        "path": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "prin": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "sub": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "num": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "alpha": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "altNum": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "okA": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "errA": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "flow": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fromAtom": {
                "type": "integer",
                "minimum": 0
              },
              "fromBond": {
                "type": "integer",
                "minimum": 0
              },
              "toAtom": {
                "type": "integer",
                "minimum": 0
              },
              "toBond": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [],
            "additionalProperties": false,
            "allOf": [
              {
                "oneOf": [
                  {
                    "required": [
                      "fromAtom"
                    ],
                    "not": {
                      "required": [
                        "fromBond"
                      ]
                    }
                  },
                  {
                    "required": [
                      "fromBond"
                    ],
                    "not": {
                      "required": [
                        "fromAtom"
                      ]
                    }
                  }
                ]
              },
              {
                "oneOf": [
                  {
                    "required": [
                      "toAtom"
                    ],
                    "not": {
                      "required": [
                        "toBond"
                      ]
                    }
                  },
                  {
                    "required": [
                      "toBond"
                    ],
                    "not": {
                      "required": [
                        "toAtom"
                      ]
                    }
                  }
                ]
              }
            ]
          },
          "minItems": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "diagram": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "fischer",
            "newman",
            "spectrum",
            "tlc",
            "acid",
            "orbitals"
          ]
        },
        "caption": {
          "type": "string",
          "minLength": 1
        },
        "top": {
          "type": "string",
          "minLength": 1
        },
        "bottom": {
          "type": "string",
          "minLength": 1
        },
        "left": {
          "type": "string",
          "minLength": 1
        },
        "right": {
          "type": "string",
          "minLength": 1
        },
        "pKa": {
          "type": "number"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "peaks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "height": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "lines": {
                "type": "integer",
                "minimum": 1,
                "maximum": 7
              },
              "spacing": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "shape": {
                "enum": [
                  "stick",
                  "broad"
                ]
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "x",
              "height",
              "label"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "shape": {
                      "const": "broad"
                    }
                  },
                  "required": [
                    "shape"
                  ]
                },
                "then": {
                  "required": [
                    "width"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "lines": {
                      "minimum": 2
                    }
                  },
                  "required": [
                    "lines"
                  ]
                },
                "then": {
                  "required": [
                    "spacing"
                  ]
                }
              }
            ]
          },
          "minItems": 1
        },
        "subshells": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12
              },
              "electrons": {
                "type": "array",
                "minItems": 1,
                "maxItems": 7,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2
                }
              }
            },
            "required": [
              "label",
              "electrons"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "type",
        "caption"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "fischer"
              }
            }
          },
          "then": {
            "required": [
              "top",
              "bottom",
              "left",
              "right"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "acid"
              }
            }
          },
          "then": {
            "required": [
              "pKa"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "spectrum"
              }
            }
          },
          "then": {
            "required": [
              "min",
              "max",
              "unit",
              "peaks"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "orbitals"
              }
            }
          },
          "then": {
            "required": [
              "subshells"
            ]
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "molecule": {
          "type": "string",
          "minLength": 1
        },
        "highlights": {
          "$ref": "#/$defs/highlights"
        },
        "reveal": {
          "type": "boolean"
        },
        "anatomy": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "string",
                "minLength": 1
              }
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3
          },
          "minItems": 0
        },
        "diagram": {
          "$ref": "#/$defs/diagram"
        },
        "challenge": {
          "type": "object",
          "properties": {
            "prompt": {
              "type": "string",
              "minLength": 1
            },
            "answer": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "explanation": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "prompt",
            "answer",
            "explanation"
          ],
          "additionalProperties": false
        },
        "focus": {
          "enum": [
            "rule",
            "cue",
            "trap",
            "app"
          ]
        }
      },
      "required": [
        "label",
        "text",
        "highlights",
        "reveal"
      ],
      "additionalProperties": false
    },
    "lesson": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "molecule": {
          "type": "string",
          "minLength": 1
        },
        "cards": {
          "type": "object",
          "properties": {
            "rule": {
              "type": "string",
              "minLength": 1
            },
            "cue": {
              "type": "string",
              "minLength": 1
            },
            "trap": {
              "type": "string",
              "minLength": 1
            },
            "app": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "rule",
            "cue",
            "trap",
            "app"
          ],
          "additionalProperties": false
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          },
          "minItems": 2
        },
        "visualCards": {
          "type": "object",
          "properties": {
            "rule": {
              "$ref": "#/$defs/visualCard"
            },
            "cue": {
              "$ref": "#/$defs/visualCard"
            },
            "trap": {
              "$ref": "#/$defs/visualCard"
            },
            "app": {
              "$ref": "#/$defs/visualCard"
            }
          },
          "required": [
            "rule",
            "cue",
            "trap",
            "app"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "label",
        "title",
        "tag",
        "molecule",
        "cards",
        "steps",
        "visualCards"
      ],
      "additionalProperties": false
    },
    "exercise": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "lesson": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "molecule": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "anatomy": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "string",
                "minLength": 1
              }
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3
          },
          "minItems": 0
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "diagram": {
          "$ref": "#/$defs/diagram"
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stage"
          },
          "minItems": 2
        },
        "concealStructure": {
          "type": "boolean",
          "description": "Withhold the candidate graph until workshop completion, including blind audit inputs."
        }
      },
      "required": [
        "id",
        "lesson",
        "label",
        "title",
        "molecule",
        "summary",
        "stages"
      ],
      "additionalProperties": false
    },
    "stage": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "choice",
            "atoms",
            "text",
            "number"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "skill": {
          "type": "string",
          "minLength": 1
        },
        "answer": {},
        "accepted": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2
        },
        "feedback": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "hints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2
        },
        "highlights": {
          "$ref": "#/$defs/highlights"
        },
        "tolerance": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "molecule": {
          "type": "string",
          "minLength": 1,
          "description": "Optional molecule ID for a transfer stage; replaces the exercise molecule and hides its exercise-wide diagram."
        }
      },
      "required": [
        "type",
        "prompt",
        "skill",
        "explanation",
        "hints",
        "highlights"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "choice"
              }
            }
          },
          "then": {
            "properties": {
              "answer": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "answer",
              "options"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "atoms"
              }
            }
          },
          "then": {
            "properties": {
              "answer": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "answer"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            }
          },
          "then": {
            "properties": {},
            "required": [
              "accepted"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "number"
              }
            }
          },
          "then": {
            "properties": {
              "answer": {
                "type": "number"
              }
            },
            "required": [
              "answer",
              "tolerance",
              "unit"
            ]
          }
        }
      ]
    },
    "visualCard": {
      "type": "object",
      "properties": {
        "layout": {
          "enum": [
            "flow",
            "decision",
            "contrast",
            "map",
            "compare"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "label",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "layout",
        "title",
        "items"
      ],
      "additionalProperties": false
    }
  }
}
