{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Molecular graph repository",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "properties": {
      "atoms": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "e": {
              "enum": [
                "C",
                "N",
                "O",
                "H",
                "S",
                "P",
                "F",
                "Cl",
                "Br",
                "I"
              ]
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "h": {
              "type": "integer",
              "minimum": 0
            },
            "charge": {
              "type": "integer",
              "minimum": -1,
              "maximum": 1
            }
          },
          "required": [
            "e",
            "x",
            "y"
          ],
          "additionalProperties": false
        },
        "minItems": 1
      },
      "bonds": {
        "type": "array",
        "items": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "enum": [
                1,
                2,
                3
              ]
            }
          ],
          "minItems": 3,
          "maxItems": 3,
          "items": false
        },
        "minItems": 0
      },
      "w": {
        "type": "number",
        "minimum": 1
      },
      "h": {
        "type": "number",
        "minimum": 1
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "formula": {
        "type": "string",
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      },
      "cond": {
        "type": "string",
        "minLength": 1
      },
      "review": {
        "type": "string",
        "minLength": 1
      },
      "stereo": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "bond": {
              "type": "integer",
              "minimum": 0
            },
            "type": {
              "enum": [
                "wedge",
                "dash"
              ]
            }
          },
          "required": [
            "bond",
            "type"
          ],
          "additionalProperties": false
        },
        "minItems": 0
      }
    },
    "required": [
      "atoms",
      "bonds",
      "w",
      "h",
      "name",
      "formula",
      "cond",
      "review"
    ],
    "additionalProperties": false
  }
}
